# Environment files
# Every real .env variant may hold API keys / tokens. Keep .env.example
# committed as the documented template.
.env
.env.*
*.env
*.env.local
!.env.example
!**/.env.example

# Secrets, credentials and private keys — never commit these
secrets/
*.secret
*.secrets
credentials.json
*credential*.json
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
id_rsa
id_rsa.*
id_dsa
id_dsa.*
id_ecdsa
id_ecdsa.*
id_ed25519
id_ed25519.*

# Local databases and SQLite sidecar files (job data, auth sessions)
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# Runtime auth / session state captured by extractors
**/cookies.json
**/storage-state.json
**/auth-state.json
**/session.json
**/cloudflare-cookies/

# Dependencies
node_modules/
**/node_modules/
**/.package-lock.json
**/.docusaurus/
docs-site/.docusaurus/
docs-site/build/
orchestrator/build/

# Data directory (bind mount in Docker)
data/

# Crawlee / extractor runtime storage at repo root
storage/

# Extractor storage outputs and cached auth
extractors/ukvisajobs/storage/

# OS files
.DS_Store
Thumbs.db

# local temp artifacts
tmp/

# Virtual environment for Python
.venv

# Runtime storage artifacts
orchestrator/storage
